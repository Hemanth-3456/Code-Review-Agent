# OpenAI or OpenAI-Compatible AI Provider Configuration
# Examples:
# OpenAI: AI_API_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini
# Groq: AI_API_URL=https://api.groq.com/openai/v1, AI_MODEL=llama-3.3-70b-versatile
# DeepSeek: AI_API_URL=https://api.deepseek.com/v1, AI_MODEL=deepseek-chat
# OpenRouter: AI_API_URL=https://openrouter.ai/api/v1, AI_MODEL=openai/gpt-4o-mini

AI_API_KEY=your_api_key_here
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Server Port (Render sets PORT automatically)
PORT=5000
NODE_ENV=production
